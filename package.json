{
  "name": "ad-pointviz",
  "version": "0.1.0",
  "description": "Autonomous driving point cloud visualization engine based on Three.js + WebGL",
  "type": "module",
  "main": "./src/index.ts",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "test": "vitest",
    "test:run": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "keywords": [
    "autonomous-driving",
    "point-cloud",
    "three.js",
    "webgl",
    "kitti",
    "3d-visualization",
    "bev",
    "lod"
  ],
  "license": "MIT",
  "dependencies": {
    "comlink": "^4.4.1",
    "lil-gui": "^0.20.0",
    "stats.js": "^0.17.0",
    "three": "^0.180.0",
    "three-mesh-bvh": "^0.7.0",
    "troika-three-text": "^0.52.0"
  },
  "devDependencies": {
    "@types/stats.js": "^0.17.3",
    "@types/three": "^0.180.0",
    "typescript": "^5.7.0",
    "vite": "^6.0.0",
    "vitest": "^2.1.0"
  }
}
